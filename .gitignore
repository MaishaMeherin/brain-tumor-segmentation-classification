__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# --- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- Kaggle credentials -------------------------------------------------------
kaggle.json
.kaggle/

